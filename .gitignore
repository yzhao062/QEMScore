# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
dist/

# Data and results (regenerable from manifests).
# Anchored to the repository root: an unanchored data/ also matches
# qem_bench/noise/data/, which is shipped package data.
/data/
/results/

# OS / editor
.DS_Store
.idea/
.vscode/

# Agent bootstrap local state
/.agent-config/
/agent-config.local.yaml
/.claude/

# Secrets
.env
/AGENTS.md
/CLAUDE.md
/agents/codex.md
todo/*
!todo/README.md

# Third-party archives fetched for the field half. The bytes stay out of git;
# the per-file SHA-256 set is what the field freeze manifest records.
/external/

# Reviewer copies placed for a review round; not part of the change set.
/vet-review-*.md
